{
  "extends": "./tsconfig.app.json",
  "include": [
    "src/**/__tests__/*",
    "env.d.ts",
    "src/**/*.{test,spec}.ts",
    "src/**/*.{test,spec}.tsx",
    "tests/**/*.ts"],
  "exclude": [],
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.vitest.tsbuildinfo",

    "lib": [],
    "types": ["node", "jsdom","vitest/globals", "vite/client"],
    "noUnusedLocals": false,
    "noUnusedParameters": false
  }
}
